@{
    var id = (int)ViewBag.idPregunta;
}
<h1>Llegaste a la isla de calipso, intenta recordar el pasado para poder escapar</h1>

<h3>@ViewBag.pregunta</h3>

<form action='@Url.Action("VerificarTrivia", "Home")' method="get">
    <input type="hidden" name="idPregunta" value="@id" />
    @if (id == 1) {
        <text>
            <label><input type="radio" name="respuesta" value="Polifemo" required /> Polifemo</label>
            <label><input type="radio" name="respuesta" value="Antinoo" /> Antinoo</label>
            <label><input type="radio" name="respuesta" value="Euriloco" /> Euriloco</label>
            <label><input type="radio" name="respuesta" value="Elpenor" /> Elpenor</label>
        </text>
    } else if (id == 2) {
        <text>
            <label><input type="radio" name="respuesta" value="Calipso" required /> Calipso</label>
            <label><input type="radio" name="respuesta" value="Circe" /> Circe</label>
            <label><input type="radio" name="respuesta" value="Nausicaa" /> Nausicaa</label>
            <label><input type="radio" name="respuesta" value="Penelope" /> Penelope</label>
        </text>
    } else if (id == 3) {
        <text>
            <label><input type="radio" name="respuesta" value="Tiresias" required /> Tiresias</label>
            <label><input type="radio" name="respuesta" value="Eumeo" /> Eumeo</label>
            <label><input type="radio" name="respuesta" value="Cerbero" /> Cerbero</label>
            <label><input type="radio" name="respuesta" value="Argos" /> Argos</label>
        </text>
    }
    <div>
        <input type="submit" value="Enviar" />
        <input type="reset" value="Limpiar" />
    </div>
</form>
