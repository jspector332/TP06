<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <meta charset="utf-8">
  <title>Simon</title>
  <link href="https://fonts.googleapis.com/css?family=Press+Start+2P" rel="stylesheet">
  <link rel="stylesheet" href="~/css/simon.css" />
</head>

<body>
  <h1 id="level-title">Recorda la secuencia para no caer en el canto de las sirenas. <br> Toca cualquier tecla para comenzar.</h1>

  <div class="simon-wrapper">
    <div class="simon-container">
      <div id="green" class="btn green" role="button" aria-label="green"></div>
      <div id="red" class="btn red" role="button" aria-label="red"></div>
      <div id="yellow" class="btn yellow" role="button" aria-label="yellow"></div>
      <div id="blue" class="btn blue" role="button" aria-label="blue"></div>
    </div>
  </div>

</body>

</html>